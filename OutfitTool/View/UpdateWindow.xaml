<Window x:Class="OutfitTool.View.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OutfitTool.View"
        mc:Ignorable="d"
        Title="Update" 
        Height="295" 
        Width="607" ResizeMode="NoResize">
    <Grid Background="LightGray">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label x:Name="UpdateStatus" HorizontalAlignment="Center" Margin="9,0,0,0">Обновление модуля</Label>
            <Button x:Name="CancelButton" Content="Отмена" Width="120" Margin="0,12,0,0" Padding="10,3"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
